POSTGRES_USER=event_flow
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=event_flow_dev
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Canonical origin for email links. For phone testing, set this to the LAN origin.
BETTER_AUTH_URL=http://localhost:3000
# Optional additional exact origins, comma-separated; no wildcards or URL paths.
# Example with a LAN canonical origin: http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional Google OAuth web client. Configure both or leave both empty.
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_TRANSPORT=smtp
# Production only; never expose in NEXT_PUBLIC variables.
RESEND_API_KEY=
# Disable when restoring/reconciling an Outbox backup.
EMAIL_OUTBOX_ENABLED=true
# Pool + two dedicated listeners; reserve additional DB slots for operations.
DATABASE_POOL_MAX=5
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@event-flow.local

# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Preserve this key and back it up separately; existing Tickets require it.
TICKET_CREDENTIAL_ENCRYPTION_KEY=

# Required only for media operations. Use an existing absolute directory, mode 0700,
# outside Git/public/.next and temporary directories. Expand your own home path.
# Example: /Users/your-user/Library/Application Support/Event Flow/media
MEDIA_STORAGE_ROOT=
