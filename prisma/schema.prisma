generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid(7)) @db.Uuid
  name             String
  email            String
  emailVerified    Boolean           @default(false)
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         Session[]
  accounts         Account[]
  organizerProfile OrganizerProfile?
  applications     Application[]

  @@unique([email])
  @@map("user")
}

model OrganizerProfile {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    Event[]
}

enum EventVisibility {
  PUBLIC
  PRIVATE
}

enum EventAccountRequirement {
  REQUIRED
  OPTIONAL
}

model Event {
  id                   String                  @id @default(uuid(7)) @db.Uuid
  organizerId          String                  @db.Uuid
  organizer            OrganizerProfile        @relation(fields: [organizerId], references: [id])
  title                String
  description          String?
  startsAt             DateTime                @db.Timestamptz(3)
  endsAt               DateTime                @db.Timestamptz(3)
  timezone             String
  visibility           EventVisibility         @default(PRIVATE)
  accountRequirement   EventAccountRequirement @default(OPTIONAL)
  capacity             Int?
  registrationOpensAt  DateTime?               @db.Timestamptz(3)
  registrationClosesAt DateTime?               @db.Timestamptz(3)
  publishedAt          DateTime?               @db.Timestamptz(3)
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(3)

  publicId            String?           @unique @db.Uuid
  publishedRevisionId String?           @unique @db.Uuid
  contentVersion      Int               @default(1)
  revisions           EventRevision[]   @relation("EventRevisions")
  publishedRevision   EventRevision?    @relation("CurrentPublishedRevision", fields: [id, publishedRevisionId], references: [eventId, id], onDelete: Restrict, onUpdate: Restrict)
  registrationForm    RegistrationForm?
  applications        Application[]

  @@unique([id, publishedRevisionId])
  @@index([organizerId, createdAt])
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum RegistrationFieldType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  CHECKBOX
}

model RegistrationForm {
  id        String              @id @default(uuid(7)) @db.Uuid
  eventId   String              @unique @db.Uuid
  event     Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @db.Timestamptz(3)
  fields    RegistrationField[]
}

model RegistrationField {
  id          String                    @id @default(uuid(7)) @db.Uuid
  formId      String                    @db.Uuid
  form        RegistrationForm          @relation(fields: [formId], references: [id], onDelete: Cascade)
  type        RegistrationFieldType
  label       String
  description String?
  required    Boolean                   @default(false)
  position    Int
  createdAt   DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                  @updatedAt @db.Timestamptz(3)
  options     RegistrationFieldOption[]

  @@unique([formId, position])
}

model RegistrationFieldOption {
  id        String            @id @default(uuid(7)) @db.Uuid
  fieldId   String            @db.Uuid
  field     RegistrationField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  label     String
  position  Int
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([fieldId, position])
}

model EventRevision {
  id              String        @id @default(uuid(7)) @db.Uuid
  eventId         String        @db.Uuid
  event           Event         @relation("EventRevisions", fields: [eventId], references: [id])
  currentForEvent Event?        @relation("CurrentPublishedRevision")
  number          Int
  contentVersion  Int
  snapshot        Json
  publishedAt     DateTime      @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  applications    Application[]

  @@unique([eventId, id])
  @@unique([eventId, number])
  @@unique([eventId, contentVersion])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

model Application {
  id              String              @id @default(uuid(7)) @db.Uuid
  eventId         String              @db.Uuid
  eventRevisionId String              @db.Uuid
  userId          String?             @db.Uuid
  user            User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  event           Event               @relation(fields: [eventId], references: [id], onDelete: Restrict)
  eventRevision   EventRevision       @relation(fields: [eventId, eventRevisionId], references: [eventId, id], onDelete: Restrict)
  fullName        String
  email           String
  status          ApplicationStatus   @default(PENDING)
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  reviewedAt      DateTime?           @db.Timestamptz(3)
  withdrawnAt     DateTime?           @db.Timestamptz(3)
  answers         ApplicationAnswer[]

  @@unique([eventId, email], where: raw("(status = ANY (ARRAY['PENDING'::\"ApplicationStatus\", 'APPROVED'::\"ApplicationStatus\", 'REJECTED'::\"ApplicationStatus\"]))"))
  @@unique([eventId, userId], where: raw("(status = ANY (ARRAY['PENDING'::\"ApplicationStatus\", 'APPROVED'::\"ApplicationStatus\", 'REJECTED'::\"ApplicationStatus\"]))"))
  @@index([eventId, userId, createdAt])
  @@index([eventId, status])
  @@index([eventRevisionId])
}

model ApplicationAnswer {
  id              String                    @id @default(uuid(7)) @db.Uuid
  applicationId   String                    @db.Uuid
  application     Application               @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // Historical identifiers refer only to the immutable revision snapshot.
  fieldId         String                    @db.Uuid
  textValue       String?
  booleanValue    Boolean?
  selectedOptions ApplicationAnswerOption[]

  @@unique([applicationId, fieldId])
}

model ApplicationAnswerOption {
  answerId String            @db.Uuid
  optionId String            @db.Uuid
  answer   ApplicationAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@id([answerId, optionId])
}

enum EmailOutboxType {
  APPLICATION_RECEIVED
  NEW_APPLICATION
  APPLICATION_APPROVED
  APPLICATION_REJECTED
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model EmailOutbox {
  id               String            @id @default(uuid(7)) @db.Uuid
  type             EmailOutboxType
  status           EmailOutboxStatus @default(PENDING)
  deduplicationKey String            @unique
  recipientEmail   String
  payload          Json
  attempts         Int               @default(0)
  nextAttemptAt    DateTime?         @default(now()) @db.Timestamptz(3)
  lockedAt         DateTime?         @db.Timestamptz(3)
  lockedBy         String?
  sentAt           DateTime?         @db.Timestamptz(3)
  lastError        String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt, createdAt])
  @@index([status, lockedAt])
}
